      "expect": {
        "scope": {"service": "checkout", "environment": "prod", "fromUtc": "2026-03-10T23:00:00Z", "toUtc": "2026-03-11T23:00:00Z", "kinds": []},
        "mustRetrieve": ["incident_inc-checkout-latency", "monitor_1001", "log_co-1", "log_co-2"],
        "mayRetrieve": ["slo_slo-checkout-avail"],
        "mustNotRetrieve": ["monitor_1002", "incident_inc-checkout-latency-stg", "incident_inc-checkout-deploy", "log_co-stg", "log_co-old", "incident_inc-worker-backlog", "monitor_1003", "log_worker-1"],
        "timeline": {"status": "collected", "observations": [
          {"id": "obs-2", "kind": "spike", "service": "checkout"},
          {"id": "obs-3", "kind": "logBurst", "service": "checkout"}
        ]}
      },
      "live": {
        "metrics": [{"query": "avg:trace.http.request.duration{service:checkout,env:prod}", "baseline": 0.2,
                     "spikes": [{"at": "2026-03-11T10:00:00Z", "value": 1.5}, {"at": "2026-03-11T11:00:00Z", "value": 1.6}]}],
        "logs": [{"query": "service:checkout env:prod status:(error OR warn)",
                  "bursts": [{"at": "2026-03-11T10:10:00Z", "count": 8, "message": "db connection pool exhausted: 50/50 connections in use"}]}]
      },
      "hypotheses": [{"statement": "Database connection pool exhaustion slowed checkout", "observationIds": ["obs-2", "obs-3"]}],
      "answer": {"citeDocuments": ["incident_inc-checkout-latency", "monitor_1001", "log_co-2"], "citeObservations": ["obs-2", "obs-3"]}
