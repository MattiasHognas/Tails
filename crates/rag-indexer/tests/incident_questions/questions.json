{
  "version": 3,
  "description": "Incident questions for the /ask quality harness (crates/rag-indexer/src/pipeline_tests/quality.rs). Each question is answered by the real pipeline over corpus.json plus the recorded fixtures, with deterministic embeddings, a canned planner reply ('plan') and a canned answer model that cites 'answer'. Logs are indexed grouped by message pattern and UTC day; 'log_<id>' names the log pattern that holds Datadog log <id>, which is one source whichever of its days are retrieved. 'evidence' lists facts the answer prompt must state about a source, such as a pattern's count in the question's window. See docs/DEVELOPMENT.md#incident-question-set for the metrics and how to add questions or change thresholds.",
  "defaults": {"now": "2026-03-12T09:00:00Z", "timezone": "Europe/Stockholm"},
  "thresholds": {
    "recallAtK": 0.95,
    "precisionAtR": 0.9,
    "distractorExclusion": 1.0,
    "scopeAccuracy": 1.0,
    "citationValidity": 1.0,
    "citationAccuracy": 1.0,
    "observationRecall": 1.0,
    "negativeControlsFlagged": 1.0,
    "evidenceAccuracy": 1.0
  },
  "questions": [
